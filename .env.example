# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API
#
# Both values are safe in the browser bundle. The anon key is designed to be
# public — your data is protected by the row-level security policies in
# supabase/migrations, not by hiding this key.
#
# NEVER put the service_role key here. It bypasses RLS entirely.
#
# Leave both unset to run CRMO in local mode against localStorage.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
